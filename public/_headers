# Cloudflare Pages / Netlify response headers.
# Workers take their Content-Security-Policy from HTTP headers (the page's
# meta tag does not cover them), so the same policy is set here for every file.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The analysis worker runs the Wiregasm engine, whose Emscripten/embind glue
# builds small helper functions with `new Function` at start-up, so the worker
# needs 'unsafe-eval'. connect-src stays 'self': the worker still cannot send
# capture data anywhere. The page itself keeps the stricter policy above.
/assets/analysis.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; connect-src 'self'; object-src 'none'; base-uri 'self'

/wiregasm/*
  Cache-Control: public, max-age=604800
